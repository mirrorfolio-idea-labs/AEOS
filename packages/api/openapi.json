{
  "openapi": "3.1.0",
  "info": {
    "title": "AEOS API",
    "description": "Local-first API over the AEOS daemon. Envelope: { success, data, error, meta }.",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "description": "Liveness + AEOS_HOME identity.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "description": "List workspaces.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "tags": [
          "workspaces"
        ],
        "description": "Create a workspace.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/workspaces/{id}": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "description": "Get one workspace.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents": {
      "get": {
        "tags": [
          "agents"
        ],
        "description": "List agents in a workspace.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "tags": [
          "agents"
        ],
        "description": "Create an agent (registry-backed, git-initialized).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}": {
      "get": {
        "tags": [
          "agents"
        ],
        "description": "Get one agent.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}/credential-profile": {
      "post": {
        "tags": [
          "agents"
        ],
        "description": "BYOK on-the-go switch (spec §14): point the agent at another credential profile; takes effect next spawn.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}/repos": {
      "post": {
        "tags": [
          "agents"
        ],
        "description": "Bind a repository (spec §7): objectives targeting it run in their own git worktree on an aeos/<agent>/<objective> branch — never in the checkout itself.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}/repos/{repoId}": {
      "delete": {
        "tags": [
          "agents"
        ],
        "description": "Unbind a repository. Existing worktrees and agent branches are left in place.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "repoId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/objectives": {
      "post": {
        "tags": [
          "objectives"
        ],
        "description": "Create an objective with its plan.md.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/objectives/{id}/start": {
      "post": {
        "tags": [
          "objectives"
        ],
        "description": "Start (or resume) the objective through the sequential scheduler. Idempotent while running.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/stop": {
      "get": {
        "tags": [
          "stop"
        ],
        "description": "Kill-switch status.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "tags": [
          "stop"
        ],
        "description": "Engage the kill switch: creates <AEOS_HOME>/STOP. Running tasks finish their current session; nothing new spawns (spec §18).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "delete": {
        "tags": [
          "stop"
        ],
        "description": "Lift the kill switch (removes the STOP file).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/objectives/{id}/plan/approve": {
      "post": {
        "tags": [
          "objectives"
        ],
        "description": "Human approval of a planner-proposed plan (plan.proposed.md → plan.md), then start. Works after a denial or expiry too.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/objectives/{id}": {
      "get": {
        "tags": [
          "objectives"
        ],
        "description": "Objective status derived from plan.md + checkpoints (files are truth).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/objectives/{id}/diff": {
      "get": {
        "tags": [
          "objectives"
        ],
        "description": "Unified diff of the objective worktree: uncommitted | branch (since the objective began) | last-commit.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/objectives/{id}/review": {
      "post": {
        "tags": [
          "objectives"
        ],
        "description": "Send review comments back to the agent: appends an R<n> task to plan.md with the comments as its notes, then (by default) starts the objective.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}/status": {
      "get": {
        "tags": [
          "runtime"
        ],
        "description": "Current attention status of one agent (idle | working | blocked | done | unknown).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}/wait": {
      "get": {
        "tags": [
          "runtime"
        ],
        "description": "Long-poll until the agent reaches one of `until` (default blocked,done). Pass `afterSeq` (from a prior status read) to require a NEW transition — race-free act-then-wait.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/inbox": {
      "get": {
        "tags": [
          "runtime"
        ],
        "description": "Every agent, attention-sorted: blocked → finished-unseen → working → idle → settled.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/agents/{id}/attention": {
      "post": {
        "tags": [
          "runtime"
        ],
        "description": "Triage: seen (clear unseen), unread (force unseen), settle (sink until new activity), unsettle.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/memory/index": {
      "get": {
        "tags": [
          "memory"
        ],
        "description": "MEMORY.md index + budgets (lazily initialized).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/memory/file": {
      "get": {
        "tags": [
          "memory"
        ],
        "description": "Read one memory file by repo-relative path.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/memory/search": {
      "get": {
        "tags": [
          "memory"
        ],
        "description": "FTS search over the agent memory (rebuilds lazily).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "description": "Canonical event stream (SSE) with filters + backfill.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/approvals": {
      "get": {
        "tags": [
          "approvals"
        ],
        "description": "Pending approval requests (spec §11 approvals flow).",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/v1/approvals/{requestId}": {
      "post": {
        "tags": [
          "approvals"
        ],
        "description": "Answer a pending approval. Unanswered requests deny on expiry.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "requestId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  }
}
