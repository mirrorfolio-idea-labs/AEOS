{
  "$ref": "#/definitions/agent-config",
  "definitions": {
    "agent-config": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "harness": {
          "type": "object",
          "properties": {
            "provider": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "claude-code",
                    "codex",
                    "opencode"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^plugin:[a-z0-9][a-z0-9-]{0,62}$"
                }
              ]
            },
            "version": {
              "type": "string"
            },
            "binaryPath": {
              "type": "string",
              "minLength": 1
            },
            "featureToggles": {
              "type": "object",
              "properties": {
                "plugins": {
                  "type": "boolean",
                  "default": false
                },
                "skills": {
                  "type": "boolean",
                  "default": false
                },
                "mcpServers": {
                  "type": "boolean",
                  "default": false
                },
                "userClaudeMd": {
                  "type": "boolean",
                  "default": false
                },
                "autoMemory": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "credentialProfileId": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modelPreferences": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "baseRef": {
                "type": "string",
                "minLength": 1
              },
              "verify": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "workspaceId",
        "name",
        "harness",
        "credentialProfileId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
