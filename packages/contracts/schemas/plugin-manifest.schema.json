{
  "$ref": "#/definitions/plugin-manifest",
  "definitions": {
    "plugin-manifest": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "contributes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "provider",
                  "memory-backend",
                  "planner",
                  "scheduler-job",
                  "policy",
                  "ui-panel",
                  "deploy-target"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "contract",
        "entry",
        "contributes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
