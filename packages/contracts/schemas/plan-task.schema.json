{
  "$ref": "#/definitions/plan-task",
  "definitions": {
    "plan-task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "blocked"
          ]
        },
        "taskClass": {
          "type": "string",
          "enum": [
            "plan",
            "architect",
            "implement",
            "refactor",
            "review",
            "security_review",
            "summarize",
            "docs",
            "rename",
            "verify"
          ],
          "default": "implement"
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
