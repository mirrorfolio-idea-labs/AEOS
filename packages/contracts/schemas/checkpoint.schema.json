{
  "$ref": "#/definitions/checkpoint",
  "definitions": {
    "checkpoint": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "blocked"
          ]
        },
        "commit": {
          "type": "string"
        },
        "providerResumeToken": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "costs": {
          "type": "object",
          "properties": {
            "usd": {
              "type": "number",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "usd",
            "tokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "taskId",
        "status",
        "summary",
        "costs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
