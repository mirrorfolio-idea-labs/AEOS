{
  "$ref": "#/definitions/checkpoint",
  "definitions": {
    "checkpoint": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "blocked"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "commit": {
          "type": "string"
        },
        "providerResumeToken": {
          "type": "string"
        },
        "verification": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "flaky"
              ]
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "attempts": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "outputTail": {
                    "type": "string"
                  }
                },
                "required": [
                  "command",
                  "exitCode",
                  "attempts",
                  "outputTail"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "outcome",
            "commands"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "costs": {
          "type": "object",
          "properties": {
            "usd": {
              "type": "number",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "usd",
            "tokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "taskId",
        "status",
        "summary",
        "costs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
