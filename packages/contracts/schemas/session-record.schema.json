{
  "$ref": "#/definitions/session-record",
  "definitions": {
    "session-record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9ABCDEFGHJKMNPQRSTVWXYZ]{26}$"
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "objectiveId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "created",
            "starting",
            "running",
            "waiting_approval",
            "paused",
            "completed",
            "failed",
            "orphaned"
          ]
        },
        "providerSessionId": {
          "type": "string"
        },
        "runnerPid": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "runnerSocket": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "agentId",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
