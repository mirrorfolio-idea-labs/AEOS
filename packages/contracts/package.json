{
  "name": "@aeos/contracts",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrorfolio-idea-labs/AEOS.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/mirrorfolio-idea-labs/AEOS",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "zod-to-json-schema": "^3.23.5"
  }
}
