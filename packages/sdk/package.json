{
  "name": "@aeos/sdk",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrorfolio-idea-labs/AEOS.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/mirrorfolio-idea-labs/AEOS",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../api/openapi.json -o src/generated/openapi-types.ts"
  },
  "dependencies": {
    "@aeos/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "openapi-typescript": "^7.4.0",
    "vitest": "^2.1.8",
    "@aeos/api": "workspace:*",
    "@aeos/kernel": "workspace:*",
    "@aeos/provider-core": "workspace:*"
  }
}
