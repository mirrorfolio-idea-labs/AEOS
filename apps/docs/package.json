{
  "name": "@aeos/docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "build": "pnpm -F @aeos/site release-data && node scripts/sync-docs.mjs && astro build && node scripts/check-links.mjs",
    "typecheck": "node -e \"\"",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "demo:assets": "node scripts/demo-assets.mjs"
  },
  "dependencies": {
    "@aeos/site": "workspace:*",
    "@astrojs/react": "^7.0.0",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "1.61.1"
  }
}
