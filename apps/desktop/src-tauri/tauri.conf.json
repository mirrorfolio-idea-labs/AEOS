{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEOS",
  "version": "0.1.0",
  "identifier": "com.mirrorfolio.aeos",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AEOS",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Durable AI coding agents, local-first",
    "linux": { "deb": { "depends": [] } }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["aeos"] }
    }
  }
}
