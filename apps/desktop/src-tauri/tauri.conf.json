{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEOS",
  "version": "../package.json",
  "identifier": "com.mirrorfolio.aeos",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AEOS",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Durable AI coding agents, local-first",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aeos"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://mirrorfolio-idea-labs.github.io/AEOS/updates/latest.json"
      ]
    }
  }
}
